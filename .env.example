# 大模型配置（OpenAI 兼容接口）。不填 AI_API_KEY 时网站以「演示模式」运行，使用规则引擎检测。
# 默认使用智谱开放平台的免费模型：https://open.bigmodel.cn
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 文本模型（需支持工具调用 Function Calling）
AI_MODEL=glm-4.7-flash
# 视觉模型（用于识别截图）
AI_VISION_MODEL=glm-4.6v-flash
# 主模型繁忙（429）时依次换用的备用模型，逗号分隔；都失败时自动交给规则引擎
AI_FALLBACK_MODELS=glm-4.6v-flash

# 限流（按访问者 IP，都可不填，用默认值）
# 每分钟请求上限：超出返回「操作有点太快」
RATE_LIMIT_DETECT_PER_MIN=8
RATE_LIMIT_GUARD_PER_MIN=20
RATE_LIMIT_DRILL_PER_MIN=30
# 每天调用大模型的上限（单个 IP / 全站），用完后自动改用规则引擎，次日 0 点（北京时间）恢复
AI_DAILY_LIMIT_PER_IP=100
AI_DAILY_LIMIT_TOTAL=3000
